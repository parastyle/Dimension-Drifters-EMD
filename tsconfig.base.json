{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // Colyseus @colyseus/schema uses legacy decorators (@type). These two are load-bearing:
    // experimentalDecorators enables @type; useDefineForClassFields:false stops field
    // initializers from clobbering decorated fields. Do not flip without testing sync.
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  }
}
