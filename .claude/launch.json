{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 5180
    },
    {
      "name": "client-only",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:client"],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "weaponsmith",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tools/weaponsmith/server.mjs"],
      "port": 5050
    },
    {
      "name": "art-review",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tools/artkit/review/server.mjs"],
      "port": 8190
    },
    {
      "name": "proto",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5199", "--directory", "docs/prototypes"],
      "port": 5199
    },
    {
      "name": "portal",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5300", "--directory", "tools/portal"],
      "port": 5300
    }
  ]
}
