# Vite loads this file ONLY when running in development mode (`pnpm dev`).
# Production builds use .env.production / no file at all, so the dev-tools gate stays
# fail-closed in shipped bundles — see docs/sol-reports/audit-engineering-practice.md F3.
#
# Without this, `clientDevToolsEnabled()` returns false during ordinary development, which
# silently disables the `?dev=` deep links (boss / weapon / char / enemy / gear test launches)
# and every other client-side dev affordance.
VITE_DD_DEV_TOOLS=1
